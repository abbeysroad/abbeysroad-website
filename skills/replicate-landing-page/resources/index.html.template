<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NordisTravel | Premium Scandinavian Vacations</title>
  <meta name="description" content="Embark on extraordinary summer journeys through Sweden, Norway, Finland, and Denmark on a premium, curated Scandinavian vacation.">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- GLOBAL HEADER & NAVIGATION -->
  <header id="main-header">
    <div class="header-container">
      <div class="logo-container">
        <a href="#" class="logo-link">
          <img src="images/logo.png" alt="NordisTravel Logo" id="header-logo">
        </a>
      </div>
      <nav>
        <ul class="nav-links">
          <li class="dropdown-item">
            <a href="#" class="dropdown-trigger" id="dropdown-tours">Itineraries ▾</a>
            <ul class="dropdown-menu" id="itineraries-menu">
              <!-- Dynamically populated -->
            </ul>
          </li>
          <li class="dropdown-item">
            <a href="#" class="dropdown-trigger" id="dropdown-flags">Destinations ▾</a>
            <ul class="dropdown-menu flags-menu" id="flags-menu">
              <li><label><input type="checkbox" class="country-filter" value="Denmark" checked> 🇩🇰 Denmark</label></li>
              <li><label><input type="checkbox" class="country-filter" value="Norway" checked> 🇳🇴 Norway</label></li>
              <li><label><input type="checkbox" class="country-filter" value="Sweden" checked> 🇸🇪 Sweden</label></li>
              <li><label><input type="checkbox" class="country-filter" value="Finland" checked> 🇫🇮 Finland</label></li>
              <li><label><input type="checkbox" class="country-filter" value="Iceland"> 🇮🇸 Iceland</label></li>
            </ul>
          </li>
          <li><a href="#about-section">About Us</a></li>
          <li><a href="#team-section">Meet The Team</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- DYNAMIC ITINERARY VIEWPORT -->
  <div id="itinerary-viewport" class="itinerary-viewport">
    <!-- Dynamically rendered by app.js -->
  </div>

  <!-- GLOBAL ABOUT US SECTION -->
  <section class="about-section" id="about-section">
    <div class="section-header">
      <h2>ABOUT NORDISTRAVEL</h2>
      <p>Crafting lifetime memories across the landscapes of Northern Europe.</p>
    </div>
    <div class="about-content-grid">
      <div class="about-text-card">
        <h3>Our Mission</h3>
        <p>At NordisTravel, we believe that travel should be more than sightseeing—it should be an immersive, seamless, and high-fidelity experience. We specialize in curating premium, hand-crafted itineraries across Denmark, Norway, Sweden, Finland, and Iceland. By handling all transits, premium lodging, and local guides, we leave you free to simply enjoy the journey.</p>
      </div>
      <div class="about-text-card">
        <h3>Premium Comfort</h3>
        <p>From the moment you touch down to your final departure, you travel in style. Our tours combine scenic luxury trains (like the Flåm Railway), overnight Baltic cruise ships in private sea view cabins, and hand-selected boutique hotels. We maintain a relaxed but active pace, ensuring you see the highlights without feeling rushed.</p>
      </div>
    </div>
  </section>

  <!-- GLOBAL MEET THE TEAM SECTION -->
  <section class="team-section" id="team-section">
    <div class="section-header">
      <h2>MEET THE TEAM</h2>
      <p>The travel designers and guides behind your epic Nordic adventures.</p>
    </div>
    <div class="team-grid">
      <div class="team-card">
        <div class="team-img-container">
          <img src="images/team_manager_1.jpg" alt="Karin Bergström">
        </div>
        <div class="team-info">
          <h4>Karin Bergström</h4>
          <p class="team-role">Lead Tour Operations Manager</p>
          <p class="team-bio">Born in Stockholm, Karin has spent over 12 years coordinating luxury travel across Sweden and Norway. She ensures every rail pass, cruise cabin, and local transfer aligns perfectly.</p>
        </div>
      </div>
      <div class="team-card">
        <div class="team-img-container">
          <img src="images/contact_footer.jpg" alt="NordisTravel Designers">
        </div>
        <div class="team-info">
          <h4>Nordis Travel Specialists</h4>
          <p class="team-role">Design & Support Team</p>
          <p class="team-bio">Our dedicated team in Copenhagen works round-the-clock to manage operations, customize excursions, and provide 24/7 support throughout your escape.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER & CONTACT DETAILS -->
  <footer id="global-footer">
    <!-- Rendered dynamically or shared -->
    <div class="footer-content" id="footer-content-dynamic">
      <!-- Populated dynamically to match active itinerary contact details -->
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 NordisTravel. All rights reserved. Registered in Denmark.</p>
      <p>Designed for Ultimate Comfort</p>
    </div>
  </footer>

  <script src="app.js"></script>
</body>
</html>
